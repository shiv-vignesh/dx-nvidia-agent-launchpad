# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# These are used on the HOST, tonight, for downloads. They are NOT placed inside the
# sandbox: the OpenShell gateway injects secrets at egress; the agent sees placeholders.

# NGC API key — required for `docker login nvcr.io` to pull the vLLM image.
# Get one at https://ngc.nvidia.com (User > Setup > Generate API Key).
NGC_API_KEY=

# Hugging Face token — forwarded ONLY to the one-shot weight downloader during onboarding,
# and used by `hf download` in bundle-offline.sh. Read access is enough for these models.
HF_TOKEN=

# Telegram bot token — ONLY if the demo uses the Telegram channel. Collected by NemoClaw,
# stored in the gateway credential store, never inside the sandbox. Leave blank otherwise.
TELEGRAM_BOT_TOKEN=

# ── Optional overrides (scripts fall back to configs/models.md if unset) ──
# USB mount point used by bundle/verify scripts:
# USB_DIR=/Volumes/USB
# Where to stage the HF cache before copying to USB:
# HF_HOME=$HOME/.cache/huggingface
# Target platform for docker save / pip download:
# TARGET_PLATFORM=linux/arm64
# PIP_PLATFORM=manylinux2014_aarch64
# PY_VERSION=3.12
