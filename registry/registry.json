// OUR model registry (GB10 deployment). Consumers call ONE endpoint — this router (:9000) —
// and pick the model by name; the router forwards to the right vLLM instance. Add/swap a
// model here; agents/UI never change. Full-line // comments only (stripped before parse).
{
  "router": { "host": "127.0.0.1", "port": 9000 },
  "default_model": "qwen3.6",

  "backends": {
    "vllm-qwen":     { "base_url": "http://127.0.0.1:8000/v1", "api_key": "x" },
    "vllm-nemotron": { "base_url": "http://127.0.0.1:8001/v1", "api_key": "x" }
    // dev-only (laptop): "ollama": { "base_url": "http://127.0.0.1:11434/v1", "api_key": "ollama-local" }
  },

  "models": {
    // upstream_model = each vLLM's --served-model-name
    "qwen3.6":  { "backend": "vllm-qwen",     "upstream_model": "qwen3.6" },
    "nemotron": { "backend": "vllm-nemotron", "upstream_model": "nemotron" }
  }
}
