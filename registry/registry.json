// OUR model registry. The agent (OpenClaw) and the stack (OpenShell inference.local)
// call ONE endpoint: this router. Swap a model's backend here; the agent never changes.
// Full-line // comments only (stripped before parse); everything else is valid JSON.
{
  "router": { "host": "127.0.0.1", "port": 9000 },
  "default_model": "qwen2.5:7b",

  "backends": {
    "ollama":  { "base_url": "http://127.0.0.1:11434/v1", "api_key": "ollama-local" },
    "vllm":    { "base_url": "http://127.0.0.1:8000/v1",  "api_key": "placeholder" },
    "colibri": { "base_url": "http://127.0.0.1:8001/v1",  "api_key": "placeholder" }
  },

  "models": {
    // runnable on the Mac tonight:
    "qwen2.5:7b":  { "backend": "ollama",  "upstream_model": "qwen2.5:7b" },
    // tomorrow on the GB10 - swap the SAME logical name to vLLM, agent untouched:
    "qwen3.6-35b": { "backend": "vllm",    "upstream_model": "nvidia/Qwen3.6-35B-A3B-NVFP4" },
    // a colibri-served frontier MoE option (OpenAI-compatible on its own port):
    "glm-5.2":     { "backend": "colibri", "upstream_model": "/nvme/glm52_i4" }
  }
}
